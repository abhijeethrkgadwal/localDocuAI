{
  "name": "localdoc-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, local-first document automation",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @localdoc/web dev",
    "build": "pnpm -r run build",
